---
import '@ds-gn/tokens/public';
import '@ds-gn/tokens/theme';
import '@ds-gn/tokens/properties';
import Showcase from '../components/Showcase.jsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>DS-GN Astro SSR</title>
    <style>
      :global(:root) { font-family: Inter, system-ui, sans-serif; }
      :global(body) { margin: 0; }
      main { display: grid; min-height: 100vh; place-items: center; padding: 1.5rem; }
      :global(dsgn-card) { display: block; width: min(34rem, 100%); }
    </style>
  </head>
  <body>
    <main>
      <Showcase client:load />
    </main>
  </body>
</html>
